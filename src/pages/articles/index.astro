---
import Base from '../../layouts/Base.astro';
import PostIndex from '../../components/PostIndex.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import PageHero from '../../components/PageHero.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts('articles');
---

<Base title="Articles" description="Long-form articles on mathematics, programming and beyond.">
  <div class="container">
    <PageHero kicker="Field guide" title="Articles" subtitle="Mathematics, programming & beyond" illustration="layers">
      <p>
        Long-form writing in three categories: mathematics, programming, and essays beyond code. Every article is a
        Markdown file on GitHub, so you can suggest edits.
      </p>
    </PageHero>
    <CategoryNav articles={posts} />
    <PostIndex posts={posts} />
  </div>
</Base>
