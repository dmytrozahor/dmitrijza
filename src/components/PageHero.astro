---
import Illustration from './Illustration.astro';

interface Props {
  kicker: string;
  title: string;
  subtitle?: string;
  illustration: string;
}

const { kicker, title, subtitle, illustration } = Astro.props;
---

<header class="hero">
  <div class="text">
    <p class="kicker">{kicker}</p>
    <h1><span>{title}</span></h1>
    {subtitle && <p class="subtitle">{subtitle}</p>}
    <div class="body"><slot /></div>
  </div>
  <Illustration name={illustration} class="art" />
</header>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    align-items: center;
    gap: 12px;
    margin: 40px 0 32px;
    padding: clamp(28px, 4vw, 48px);
    border: 1px solid var(--border);
    border-radius: 28px;
    background: var(--ill-bg);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .text {
    position: relative;
    z-index: 1;
  }
  .kicker {
    margin: 0 0 14px;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: var(--accent);
  }
  h1 {
    margin: 0 0 12px;
    font-size: clamp(2.4rem, 6vw, 3.8rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  h1 span {
    background: linear-gradient(95deg, var(--ill-a) 0%, var(--ill-c) 55%, var(--ill-b) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .subtitle {
    margin: 0 0 18px;
    font-size: 1.2rem;
    color: var(--text-muted);
  }
  .body :global(p) {
    margin: 0;
    max-width: 52ch;
    font-weight: 500;
    color: var(--text);
  }
  .hero :global(.art) {
    margin: -24px -28px -24px 0;
  }
  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero :global(.art) {
      order: -1;
      margin: -8px -12px 0;
      max-width: 520px;
    }
  }
</style>
