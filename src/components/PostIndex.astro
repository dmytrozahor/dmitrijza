---
import PostCard from './PostCard.astro';
import { slugifyTag, url, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
  showKind?: boolean;
}

const { posts, showKind = false } = Astro.props;

// Group by year, newest first.
const byYear = new Map<number, Post[]>();
for (const post of posts) {
  const year = post.data.date.getFullYear();
  byYear.set(year, [...(byYear.get(year) ?? []), post]);
}
const allTags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
---

{
  allTags.length > 0 && (
    <ul class="tags tag-cloud" aria-label="Tags">
      {allTags.map((t) => (
        <li>
          <a class="tag" href={url(`/tags/${slugifyTag(t)}/`)}>
            #{t}
          </a>
        </li>
      ))}
    </ul>
  )
}

{posts.length === 0 && <p class="meta">Nothing published yet. Stay tuned.</p>}

{
  [...byYear].map(([year, items]) => (
    <section class="year">
      <h2 class="section-label">// {year}</h2>
      <div class="grid">
        {items.map((post) => (
          <PostCard post={post} showKind={showKind} />
        ))}
      </div>
    </section>
  ))
}

<style>
  .tag-cloud {
    margin-bottom: 40px;
  }
  .year {
    margin-bottom: 48px;
  }
</style>
